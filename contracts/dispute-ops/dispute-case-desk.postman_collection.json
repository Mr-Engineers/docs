{
  "info": {
    "name": "Dispute Case Desk",
    "description": "Bank Case Desk — MCP + REST mirrors.\n\n1. Import with `dispute-ops.postman_environment.json`.\n2. Start: `npm run start:case-desk`.\n3. Prefer REST for smoke; use MCP folder for Modus-shaped calls.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:4102" },
    { "key": "apiKey", "value": "" }
  ],
  "auth": {
    "type": "apikey",
    "apikey": [
      { "key": "key", "value": "X-Api-Key", "type": "string" },
      { "key": "value", "value": "{{apiKey}}", "type": "string" },
      { "key": "in", "value": "header", "type": "string" }
    ]
  },
  "item": [
    {
      "name": "Ops",
      "item": [
        {
          "name": "Health",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health"
          }
        },
        {
          "name": "OpenAPI JSON",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/openapi.json"
          }
        },
        {
          "name": "Demo reset",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/demo/reset"
          }
        }
      ]
    },
    {
      "name": "REST mirrors",
      "item": [
        {
          "name": "List cases",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/v1/cases"
          }
        },
        {
          "name": "GET case_189_unrecognized",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/v1/cases/case_189_unrecognized"
          }
        },
        {
          "name": "POST provisional refund 189",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"case_id\": \"case_189_unrecognized\",\n  \"amount_eur\": 189,\n  \"kind\": \"provisional\",\n  \"idempotency_key\": \"demo-refund-189\"\n}"
            },
            "url": "{{baseUrl}}/v1/refunds"
          }
        },
        {
          "name": "POST chargeback.file",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"case_id\": \"case_189_unrecognized\",\n  \"reason_code\": \"10.4\",\n  \"evidence_note\": \"Unrecognized travel charge; weak merchant\",\n  \"network_dispute_id\": \"disp_poisoned\",\n  \"idempotency_key\": \"demo-cb-189\"\n}"
            },
            "url": "{{baseUrl}}/v1/chargebacks"
          }
        }
      ]
    },
    {
      "name": "MCP",
      "item": [
        {
          "name": "tools/call case.get",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              {
                "key": "Accept",
                "value": "application/json, text/event-stream"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 1,\n  \"method\": \"tools/call\",\n  \"params\": {\n    \"name\": \"case.get\",\n    \"arguments\": { \"case_id\": \"case_189_unrecognized\" }\n  }\n}"
            },
            "url": "{{baseUrl}}/mcp"
          }
        },
        {
          "name": "tools/call refund.post",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              {
                "key": "Accept",
                "value": "application/json, text/event-stream"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 2,\n  \"method\": \"tools/call\",\n  \"params\": {\n    \"name\": \"refund.post\",\n    \"arguments\": {\n      \"case_id\": \"case_189_unrecognized\",\n      \"amount_eur\": 189,\n      \"kind\": \"provisional\"\n    }\n  }\n}"
            },
            "url": "{{baseUrl}}/mcp"
          }
        }
      ]
    }
  ]
}
