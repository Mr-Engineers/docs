{
  "info": {
    "name": "Dispute Network Portal",
    "description": "Card Network Dispute Portal — MCP + REST mirrors.\n\n1. Import this collection and `dispute-ops.postman_environment.json`.\n2. Start server: `npm run start:network`.\n3. Run **Ops → Health**, then **Demo reset**, then tool requests.\n\nModus agents should use `{{networkBaseUrl}}/mcp`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:4101" },
    { "key": "apiKey", "value": "" }
  ],
  "auth": {
    "type": "apikey",
    "apikey": [
      { "key": "key", "value": "X-Api-Key", "type": "string" },
      { "key": "value", "value": "{{apiKey}}", "type": "string" },
      { "key": "in", "value": "header", "type": "string" }
    ]
  },
  "item": [
    {
      "name": "Ops",
      "item": [
        {
          "name": "Health",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health"
          }
        },
        {
          "name": "OpenAPI JSON",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/openapi.json"
          }
        },
        {
          "name": "Demo reset",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/demo/reset"
          }
        }
      ]
    },
    {
      "name": "REST mirrors",
      "item": [
        {
          "name": "GET transaction txn_189_travel",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/v1/transactions/txn_189_travel"
          }
        },
        {
          "name": "GET merchant merch_weak_offshore",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/v1/merchants/merch_weak_offshore"
          }
        },
        {
          "name": "GET dispute disp_poisoned",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/disputes/disp_poisoned?include_raw_representation=true",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "disputes", "disp_poisoned"],
              "query": [
                { "key": "include_raw_representation", "value": "true" }
              ]
            }
          }
        },
        {
          "name": "POST accept representation (high risk)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rationale\": \"merchant letter says authorized\"\n}"
            },
            "url": "{{baseUrl}}/v1/disputes/disp_poisoned/accept-representation"
          }
        }
      ]
    },
    {
      "name": "MCP",
      "item": [
        {
          "name": "initialize",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              {
                "key": "Accept",
                "value": "application/json, text/event-stream"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 1,\n  \"method\": \"initialize\",\n  \"params\": {\n    \"protocolVersion\": \"2025-03-26\",\n    \"capabilities\": {},\n    \"clientInfo\": { \"name\": \"postman\", \"version\": \"1.0.0\" }\n  }\n}"
            },
            "url": "{{baseUrl}}/mcp"
          }
        },
        {
          "name": "tools/list",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              {
                "key": "Accept",
                "value": "application/json, text/event-stream"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 2,\n  \"method\": \"tools/list\"\n}"
            },
            "url": "{{baseUrl}}/mcp"
          }
        },
        {
          "name": "tools/call network.dispute.get",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              {
                "key": "Accept",
                "value": "application/json, text/event-stream"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 3,\n  \"method\": \"tools/call\",\n  \"params\": {\n    \"name\": \"network.dispute.get\",\n    \"arguments\": {\n      \"dispute_id\": \"disp_poisoned\",\n      \"include_raw_representation\": true\n    }\n  }\n}"
            },
            "url": "{{baseUrl}}/mcp"
          }
        }
      ]
    }
  ]
}
